{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*[Ss]lack.*",
        "hooks": [
          { "type": "command", "command": "python3 .claude/hooks/block_approval.py" }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
